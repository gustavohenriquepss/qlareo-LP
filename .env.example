# --- Planilha (fonte da verdade dos leads) ---------------------------------
# URL /exec do Apps Script publicado. Ver scripts/README.md.
# Sem isso, os leads só aparecem no log do servidor.
WAITLIST_WEBHOOK_URL=
# Segredo compartilhado com o Apps Script. A URL do web app é pública; o token
# é o que impede terceiros de escreverem na planilha.
WAITLIST_WEBHOOK_TOKEN=

# --- Aviso por e-mail (best-effort) ----------------------------------------
# Vem da integração Resend no Marketplace da Vercel (`vercel env pull`).
RESEND_API_KEY=
# Quem recebe o aviso de cada novo lead.
WAITLIST_NOTIFY_TO=
# Remetente. O padrão (onboarding@resend.dev) funciona sem verificar domínio,
# mas cai em spam com mais facilidade — troque por um domínio seu no Resend.
WAITLIST_NOTIFY_FROM=
